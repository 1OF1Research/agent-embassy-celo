# Copy to .env and fill in. Nothing in .env is ever committed.

# Port to listen on.
PORT=8787

# Public base URL of this deployment (used in the agent card services list).
# Set this to the deployment's real public URL at deploy time — do not
# ship a placeholder: the agent card publishes whatever is set here.
PUBLIC_BASE_URL=

# Celo hosted facilitator API key. Get one at https://x402.celo.org by
# signing a message with a wallet (no gas, no transaction; shown once).
# The free tier includes up to 100 mainnet credits (facilitator's pricing
# page, read 2026-11-08; the venue FAQ still states 20) and 1000 testnet
# settlements.
# settlements. Without a key the service still boots and answers 402
# challenges, but settlement cannot complete.
X402_CELO_API_KEY=

# Dedicated receipt-signing key (secp256k1, EIP-191). Signs statements
# only; it cannot move funds. Without it, receipts are issued unsigned
# and say so in their signature block.
EMBASSY_SIGNING_KEY=

# mainnet (default) or sepolia (testnet; USDC only).
CELO_NETWORK=mainnet

# Where the append-only receipt log lives.
DATA_DIR=./data

# Your agent number (optional). This service can run under an agent
# identity from the ERC-8004 registry on Celo: a number that is yours,
# registered to your wallet. Set AGENT_ID to your number and the
# service presents it — in its check descriptions, its agent card, and
# every receipt it issues. Leave it empty and the service presents no
# identity at all. Register your own number first (the registry
# contract is 0x8004A169FB4a3325136EB29fA0ceB6D2e539a432; check any
# number with ownerOf(<number>) from any Celo RPC).
AGENT_ID=

# The public web address of your agent card — the page your agent
# registration points at. Leave empty if you have none.
AGENT_CARD_URL=

# Who may pay you. Leave this empty (or off) and anyone can pay — the
# box is open. Set REQUIRE_AGENT_ID=on and only customers with their
# own agent number can pay you: the customer sends their agentId with
# the call, the service checks on Celo that the number belongs to the
# paying wallet, and everyone else is turned away before any money
# moves.
REQUIRE_AGENT_ID=

# Celo JSON-RPC endpoint, used for the agent-number ownership check
# above. Leave empty for the public Celo node of the chosen network.
CELO_RPC_URL=
